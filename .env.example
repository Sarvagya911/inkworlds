# ---- Used by the browser app (safe to expose; security comes from row-level security) ----
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Show the Claude-powered buttons (world picker, spoiler-safe companion)
VITE_AI_ENABLED=false

# ---- Server only (set these in Vercel / Netlify, never in code) ----
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001
GROQ_API_KEY=your_actual_groq_key_here
GROQ_MODEL=openai/gpt-oss-20b
AI_DAILY_LIMIT=30
# Optional: defaults to the VITE_ values above
SUPABASE_URL=
SUPABASE_ANON_KEY=
